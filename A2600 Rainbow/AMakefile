# necesitamos esto aqui
ifeq ($(OS),Windows_NT)
CC65_BIN := E:/Software/cc65/bin
CC65_INC := E:/Software/cc65/include
else
CC65_BIN := /usr/bin
CC65_INC := /usr/share/cc65/include
endif

MAKEFLAGS += --warn-undefined-variables

# definiciones del systema de destino
SYSTEM     		:= atari2600
SYSTEM_LIB 		:= atari2600.lib
SYSTEM_CONF		:= atari2600.cfg

# definiciones para mi programa
BUILD_DIR 		:= build
SRC_DIR   		:= src

# definiciones de lo que generaremos
TARGET			:= arainbow
TARGET_EXE    	:= $(BUILD_DIR)/$(TARGET).bin
TARGET_MAP    	:= $(BUILD_DIR)/$(TARGET).map
TARGET_LABELS 	:= $(BUILD_DIR)/$(TARGET).labels
SRC_FILES  		:= $(SRC_DIR)/$(TARGET).s

# los flags para las diferentes etapas
ASFLAGS 		:= -t $(SYSTEM)
LDFLAGS 		:= -C $(SYSTEM_CONF) -m $(TARGET_MAP) -Ln $(TARGET_LABELS) -vm

OBJ_FILES 		:= $(SRC_FILES:$(SRC_DIR)/%.s=$(BUILD_DIR)/%.o)
# --------------------------------------------
CC := $(CC65_BIN)/cc65
CA := $(CC65_BIN)/ca65
LD := $(CC65_BIN)/ld65

.PHONY: all run clean

all: $(TARGET_EXE)

$(TARGET_EXE): $(OBJ_FILES)
	$(LD) $(LDFLAGS) $(OBJ_FILES) $(SYSTEM_LIB) -o $@

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.s | $(BUILD_DIR)
	$(CA) $(ASFLAGS) -o $@ $<

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

clean:
	rm -f $(BUILD_DIR)/$(TARGET).*

run: $(TARGET_EXE)
	stella -format ntsc $(TARGET_EXE)
