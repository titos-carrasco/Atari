BUILD_DIR := build
SRC_DIR   := src

TARGET     := crainbow
SRC_FILES  := $(SRC_DIR)/$(TARGET).c
LD_MAP     := $(BUILD_DIR)/$(TARGET).map
LD_LABELS  := $(BUILD_DIR)/$(TARGET).labels
TARGET_EXE := $(BUILD_DIR)/$(TARGET).bin

SYSTEM     := atari2600
SYSTEM_LIB := atari2600.lib
CONFIG     := /usr/share/cc65/cfg/atari2600.cfg

CFLAGS  := -t $(SYSTEM) -I $(SRC_DIR) -T -Cl -Osir
ASFLAGS := -t $(SYSTEM)
LDFLAGS := -C $(CONFIG) -m $(LD_MAP) -Ln $(LD_LABELS) -vm

# --------------------------------------------

CC := cc65
CA := ca65
LD := ld65

OBJ_FILES := $(SRC_FILES:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)
ASM_FILES := $(SRC_FILES:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.s)

.PRECIOUS: $(ASM_FILES)

.PHONY: all clean run

all: $(TARGET_EXE)

$(TARGET_EXE): $(OBJ_FILES)
	$(LD) $(LDFLAGS) $(OBJ_FILES) $(SYSTEM_LIB) -o $@

$(BUILD_DIR)/%.o: $(BUILD_DIR)/%.s | $(BUILD_DIR)
	$(CA) $(ASFLAGS) -o $@ $<

$(BUILD_DIR)/%.s: $(SRC_DIR)/%.c | $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $<

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

clean:
	rm -f $(BUILD_DIR)/$(TARGET)
	rm -f $(BUILD_DIR)/$(TARGET).*

run: $(TARGET_EXE)
	stella -format ntsc $(TARGET_EXE)
